# Front-controller routing for the assessment platform subfolder.
# Every request that isn't an existing static asset is handed to index.php,
# which does its own routing relative to /assessment/ (see index.php).
# This does not touch rewrite rules outside this directory, so it cannot
# interfere with the parent site's own routing.

RewriteEngine On
RewriteBase /assessment/

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [L]

# Note: no `Require`/`Deny` block here. This host's AllowOverride settings
# don't permit those directives in .htaccess (it 500s the moment one is
# added), so file-level access control is handled elsewhere instead: model/
# controller/service .php files are execute-only class definitions with no
# top-level side effects, so a direct request to one is harmless either
# way. config/schema.sql should be deleted from the live deployment after
# it's been imported once - it isn't needed at runtime.
