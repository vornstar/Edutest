# Copy to .env and fill in. Never commit the real .env file.

# MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=assessment_platform
DB_USER=assessment_app
DB_PASS=change_me

# AES-256-GCM key for encrypting mark schemes / model answers at rest.
# Generate with: php -r "echo base64_encode(random_bytes(32));"
APP_ENCRYPTION_KEY=base64:change_me

# Microsoft Entra ID (Azure AD) - shared with the parent site's auth_handler.php
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=https://example.org/auth_handler.php

# Microsoft Graph
GRAPH_API_BASE=https://graph.microsoft.com/v1.0
GRAPH_SCOPES="offline_access User.Read Files.ReadWrite EduRoster.ReadBasic EduAssignments.ReadWriteBasic Group.Read.All"

# OneDrive storage location (App Folder or a dedicated SharePoint/OneDrive drive id)
ONEDRIVE_DRIVE_ID=
ONEDRIVE_ROOT_FOLDER=/Assessments

# Session
SESSION_NAME=assessment_sess
SESSION_LIFETIME_MINUTES=480
