# Copy to .env at the site root (same level as index.php/auth_handler.php)
# and fill in real values. .env is gitignored - never commit it.

# Microsoft Entra ID (Azure AD) app registration client secret.
# Tenant ID and client ID stay inline in auth_handler.php since they aren't
# secret (they're visible in the browser's OAuth redirect URL anyway) - only
# the client secret needs to be kept out of source control.
AZURE_CLIENT_SECRET=

# u781387176_core database (used only by auth_handler.php's dual-database sync)
CORE_DB_PASSWORD=

# u781387176_assessment database (the assessment platform's own database)
ASSESSMENT_DB_PASSWORD=

# AES-256-GCM key the assessment platform uses to encrypt mark schemes /
# model answers at rest. Generate with:
#   php -r "echo base64_encode(random_bytes(32));"
# Changing this after data has been encrypted makes it unreadable.
ASSESSMENT_ENCRYPTION_KEY=

# Shared OneDrive/SharePoint drive id the assessment platform stores files
# in (must NOT be left blank - see assessment/services/OneDriveService.php).
ASSESSMENT_ONEDRIVE_DRIVE_ID=
